NODE_ENV=development
PORT=5000

# Database (leave empty or placeholder in dev to skip DB connection)
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Cloudinary (optional for Step 1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Seed Credentials (used in Auth step)
ADMIN_EMAIL=
ADMIN_PASSWORD=

